# ============================================================
# SEARCH PRODUCT
# ============================================================

def search_product(inventory):
    print("\n========== SEARCH PRODUCT ==========")

    if not inventory:
        print("Inventory is empty.")
        return

    keyword = input(
        "Enter Product ID, Name, or Category: "
    ).strip().lower()

    if not keyword:
        print("Search keyword cannot be empty.")
        return

    found = False

    for product_id, product in inventory.items():

        if (
            keyword in product_id.lower()
            or keyword in product["name"].lower()
            or keyword in product["category"].lower()
        ):

            print("\nProduct Found")
            print("-" * 35)
            print(f"Product ID : {product_id}")
            print(f"Name       : {product['name']}")
            print(f"Category   : {product['category']}")
            print(f"Price      : ₹{product['price']:.2f}")
            print(f"Quantity   : {product['quantity']}")
            print("-" * 35)

            found = True

    if not found:
        print("No matching product found.")


# ============================================================
# UPDATE PRODUCT
# ============================================================

def update_product(inventory):
    print("\n========== UPDATE PRODUCT ==========")

    product_id = input("Enter Product ID: ").strip()

    if product_id not in inventory:
        print("Product not found.")
        return

    product = inventory[product_id]

    print("\nCurrent Product Details")
    print("-----------------------")
    print(f"Name     : {product['name']}")
    print(f"Category : {product['category']}")
    print(f"Price    : ₹{product['price']:.2f}")
    print(f"Quantity : {product['quantity']}")

    print("\nPress Enter to keep the current value.")

    new_name = input(
        f"New Name [{product['name']}]: "
    ).strip()

    new_category = input(
        f"New Category [{product['category']}]: "
    ).strip()

    new_price = input(
        f"New Price [{product['price']}]: "
    ).strip()

    new_quantity = input(
        f"New Quantity [{product['quantity']}]: "
    ).strip()

    if new_name:
        product["name"] = new_name

    if new_category:
        product["category"] = new_category

    if new_price:
        try:
            price = float(new_price)

            if price < 0:
                print("Price cannot be negative.")
                return

            product["price"] = price

        except ValueError:
            print("Invalid price.")
            return

    if new_quantity:
        try:
            quantity = int(new_quantity)

            if quantity < 0:
                print("Quantity cannot be negative.")
                return

            product["quantity"] = quantity

        except ValueError:
            print("Invalid quantity.")
            return

    save_inventory(inventory)

    print("\nProduct updated successfully!")


# ============================================================
# DELETE PRODUCT
# ============================================================

def delete_product(inventory):
    print("\n========== DELETE PRODUCT ==========")

    product_id = input("Enter Product ID: ").strip()

    if product_id not in inventory:
        print("Product not found.")
        return

    product = inventory[product_id]

    print("\nProduct Details")
    print("-----------------------")
    print(f"Name     : {product['name']}")
    print(f"Category : {product['category']}")
    print(f"Price    : ₹{product['price']:.2f}")
    print(f"Quantity : {product['quantity']}")

    confirmation = input(
        "\nAre you sure you want to delete this product? (y/n): "
    ).strip().lower()

    if confirmation == "y":
        del inventory[product_id]

        save_inventory(inventory)

        print("Product deleted successfully.")

    else:
        print("Deletion cancelled.")


# ============================================================
# ADD STOCK
# ============================================================

def add_stock(inventory):
    print("\n========== ADD STOCK ==========")

    product_id = input("Enter Product ID: ").strip()

    if product_id not in inventory:
        print("Product not found.")
        return

    amount = get_positive_integer(
        "Enter quantity to add: "
    )

    inventory[product_id]["quantity"] += amount

    save_inventory(inventory)

    print(
        f"Stock updated successfully. "
        f"New quantity: {inventory[product_id]['quantity']}"
    )


# ============================================================
# REMOVE STOCK
# ============================================================

def remove_stock(inventory):
    print("\n========== REMOVE STOCK ==========")

    product_id = input("Enter Product ID: ").strip()

    if product_id not in inventory:
        print("Product not found.")
        return

    current_quantity = inventory[product_id]["quantity"]

    amount = get_positive_integer(
        "Enter quantity to remove: "
    )

    if amount > current_quantity:
        print("Not enough stock available.")
        return

    inventory[product_id]["quantity"] -= amount

    save_inventory(inventory)

    print(
        f"Stock removed successfully. "
        f"Remaining quantity: {inventory[product_id]['quantity']}"
    )


# ============================================================
# LOW STOCK PRODUCTS
# ============================================================

def low_stock_report(inventory):
    print("\n========== LOW STOCK REPORT ==========")

    if not inventory:
        print("Inventory is empty.")
        return

    try:
        limit = int(
            input("Enter low-stock threshold: ")
        )

        if limit < 0:
            print("Threshold cannot be negative.")
            return

    except ValueError:
        print("Invalid threshold.")
        return

    low_stock_products = []

    for product_id, product in inventory.items():

        if product["quantity"] <= limit:
            low_stock_products.append(
                (product_id, product)
            )

    if not low_stock_products:
        print("No low-stock products.")
        return

    print("-" * 75)

    for product_id, product in low_stock_products:
        print(
            f"ID: {product_id} | "
            f"Name: {product['name']} | "
            f"Quantity: {product['quantity']}"
        )

    print("-" * 75)


# ============================================================
# INVENTORY REPORT
# ============================================================

def inventory_report(inventory):
    print("\n========== INVENTORY REPORT ==========")

    if not inventory:
        print("Inventory is empty.")
        return

    total_products = len(inventory)

    total_items = sum(
        product["quantity"]
        for product in inventory.values()
    )

    total_inventory_value = sum(
        product["price"] * product["quantity"]
        for product in inventory.values()
    )

    categories = set(
        product["category"]
        for product in inventory.values()
    )

    low_stock_count = sum(
        1
        for product in inventory.values()
        if product["quantity"] <= 5
    )

    print(f"Total Products       : {total_products}")
    print(f"Total Items          : {total_items}")
    print(f"Total Categories     : {len(categories)}")
    print(f"Low Stock Products   : {low_stock_count}")
    print(
        f"Total Inventory Value: "
        f"₹{total_inventory_value:.2f}"
    )

    print("\nCategories:")
    for category in sorted(categories):
        print(f"- {category}")


# ============================================================
# SORT PRODUCTS
# ============================================================

def sort_products(inventory):
    print("\n========== SORT PRODUCTS ==========")

    if not inventory:
        print("Inventory is empty.")
        return

    print("1. Sort by Name")
    print("2. Sort by Price")
    print("3. Sort by Quantity")
    print("4. Sort by Category")

    choice = input("Enter your choice: ").strip()

    products = list(inventory.items())

    if choice == "1":
        products.sort(
            key=lambda x: x[1]["name"].lower()
        )

    elif choice == "2":
        products.sort(
            key=lambda x: x[1]["price"]
        )

    elif choice == "3":
        products.sort(
            key=lambda x: x[1]["quantity"]
        )

    elif choice == "4":
        products.sort(
            key=lambda x: x[1]["category"].lower()
        )

    else:
        print("Invalid choice.")
        return

    print("\n" + "-" * 85)

    print(
        f"{'ID':<12}"
        f"{'Name':<25}"
        f"{'Category':<18}"
        f"{'Price':<15}"
        f"{'Quantity':<10}"
    )

    print("-" * 85)

    for product_id, product in products:
        print(
            f"{product_id:<12}"
            f"{product['name']:<25}"
            f"{product['category']:<18}"
            f"₹{product['price']:<14.2f}"
            f"{product['quantity']:<10}"
        )

    print("-" * 85)


